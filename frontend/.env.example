# Em produção, use a URL configurada no projeto Vercel do backend.
# BACKEND_API_URL=https://seu-backend.vercel.app
BACKEND_API_URL=http://127.0.0.1:5000

SUAP_PUBLIC_API_URL=https://suap.ifrn.edu.br

OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=

# Em produção, use a URL pública deste frontend:
# OAUTH2_REDIRECT_URI=https://seu-frontend.vercel.app/auth/callback
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback

# 32+ characters; encrypts the HttpOnly session cookie, including the backend JWT.
SESSION_SECRET=
SUAP_SYNC_SECRET=
