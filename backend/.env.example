# Senha secreta utilizada pelo flask
SECRET_KEY=generate-a-random-secret-with-at-least-32-characters

# Senha para criptografar o JWT
JWT_SECRET_KEY=generate-another-random-secret-with-at-least-32-characters

# URL para referenciar um banco persistente.
# Em produção, use PostgreSQL/Neon/Supabase; SQLite não é persistente na Vercel.
DATABASE_URL=sqlite:///db.sqlite

# Senha utilizada pelo "admin master"
ADMIN_PASSWORD=

# Segredo interno usado pelo frontend para sincronizar usuários SUAP
SUAP_SYNC_SECRET=

SUAP_PUBLIC_API_URL=https://suap.ifrn.edu.br

# Origens permitidas, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000